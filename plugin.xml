<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://www.phonegap.com/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-custom-config"
        version="5.1.0">

    <name>cordova-custom-config</name>
    <description>Cordova/Phonegap plugin to update platform configuration files based on preferences and config-file data defined in config.xml</description>
    <author>Dave Alden</author>

    <engines>
        <engine name="cordova" version=">=3.0.0" />
    </engines>

    <repo>https://github.com/dpa99c/cordova-custom-config.git</repo>
    <issue>https://github.com/dpa99c/cordova-custom-config/issues</issue>

    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <queries>
                <intent>
                    <action android:name="android.support.customtabs.action.CustomTabsService" />
                </intent>
            </queries>
        </config-file>

        <custom-config-file target="AndroidManifest.xml" parent="./application">
            <allow-navigation href="*://*.bupa.com.sa" />
        </custom-config-file>

        <!-- 1. Meta Install Referrer Dependency (Android) -->
        <framework src="com.adjust.sdk:adjust-android-meta-referrer:5.8.0" />

        <!-- 2. Android App Links (HTTPS Universal Links) -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity[@android:name='MainActivity']">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bupadebug.go.link" />
            </intent-filter>
        </config-file>

        <!-- 3. Custom URI Scheme: bupa:// (For Deep Linking & Deferred Deep Linking) -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity[@android:name='MainActivity']">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bupa" />
            </intent-filter>
        </config-file>
    </platform>

    <platform name="ios">
        <custom-config-file platform="ios" target="*-Info.plist" parent="NSAppTransportSecurity">
            <dict>
                <key>NSAllowsArbitraryLoads</key>
                <false/>
            </dict>
        </custom-config-file>

        <config-file target="*-Info.plist" parent="CFBundleLocalizations">
            <array>
                <string>en</string>
                <string>ar</string>
            </array>
        </config-file>

        <!-- Localisation files mapping for OutSystems MABS -->
        <resource-file src="Localisation/ar.lproj/InfoPlist.strings" target="Resources/ar.lproj/InfoPlist.strings" />

        <hook type="after_prepare" src="scripts/fixLocalizations.js" />

        <!-- 1. Custom URI Scheme: bupa:// (iOS URL Types) -->
        <config-file target="*-Info.plist" parent="CFBundleURLTypes">
            <array>
                <dict>
                    <key>CFBundleURLName</key>
                    <string>sa.com.bupa.deeplink</string>
                    <key>CFBundleURLSchemes</key>
                    <array>
                        <string>bupa</string>
                    </array>
                </dict>
            </array>
        </config-file>

        <!-- 2. SKAdNetwork Postback Copy Endpoint -->
        <config-file target="*-Info.plist" parent="NSAdvertisingAttributionReportEndpoint">
            <string>https://adjust-skadnetwork.com</string>
        </config-file>

        <!-- 3. AdAttributionKit Postback Copy Endpoint (iOS 17.4+) -->
        <config-file target="*-Info.plist" parent="AttributionCopyEndpoint">
            <string>https://adjust-skadnetwork.com</string>
        </config-file>

        <!-- 4. iOS Universal Links Entitlement -->
        <config-file target="*-Debug.plist" parent="com.apple.developer.associated-domains">
            <array>
                <string>applinks:bupadebug.go.link</string>
            </array>
        </config-file>
        <config-file target="*-Release.plist" parent="com.apple.developer.associated-domains">
            <array>
                <string>applinks:bupadebug.go.link</string>
            </array>
        </config-file>
    </platform>

    <keywords>ecosystem:cordova,cordova,phonegap,ios,android,config,configuration,plist,manifest</keywords>
    <license>MIT</license>

    <hook src="hooks/restoreBackups.js" type="before_prepare" />
    <hook src="hooks/restoreBackups.js" type="before_plugin_uninstall" />
    <hook src="hooks/applyCustomConfig.js" type="after_prepare" />
    <hook src="hooks/applyCustomConfig.js" type="before_prepare" />
    <hook src="hooks/applyCustomConfig.js" type="before_compile" />
</plugin>
